{
  "scanners": [
    {
      "id": "c",
      "source": "@groma/scanner-c@0.1.1",
      "include": [
        "**/*.c",
        "**/*.h"
      ]
    },
    {
      "id": "javascript",
      "source": "@groma/scanner-javascript@0.2.3",
      "include": [
        "**/*.js",
        "**/*.mjs",
        "**/*.cjs",
        "**/*.jsx",
        "**/package.json",
        "**/*.html",
        "**/project.json",
        "**/nx.json"
      ],
      "exclude": [
        "*.min.js",
        "*.min.mjs",
        "*.min.cjs",
        "*.min.jsx",
        "node_modules/",
        "dist/",
        "build/",
        "coverage/"
      ]
    },
    {
      "id": "kotlin",
      "source": "@groma/scanner-kotlin@0.1.3",
      "include": [
        "**/*.kt",
        "**/pom.xml",
        "**/build.gradle",
        "**/build.gradle.kts"
      ],
      "exclude": [
        "build/",
        "!**/src/*/kotlin/**/build/",
        "!**/src/*/java/**/build/",
        ".gradle/",
        "**/src/test/",
        "**/src/test[A-Z]*/",
        "**/src/*Test/",
        "**/src/*Test[A-Z]*/"
      ]
    },
    {
      "id": "python",
      "source": "@groma/scanner-python@0.2.3",
      "include": [
        "**/*.py",
        "**/pyproject.toml",
        "**/setup.cfg",
        "**/requirements.txt"
      ],
      "exclude": [
        ".venv/",
        "venv/",
        "__pycache__/",
        "test/",
        "tests/",
        "test_*.py",
        "*_test.py",
        "conftest.py",
        "build/",
        "dist/"
      ]
    },
    {
      "id": "rust",
      "source": "@groma/scanner-rust@0.2.3",
      "include": [
        "**/*.rs",
        "**/Cargo.toml"
      ],
      "exclude": [
        "target/",
        "vendor/"
      ]
    },
    {
      "id": "swift",
      "source": "@groma/scanner-swift@0.2.3",
      "include": [
        "**/*.swift"
      ],
      "exclude": [
        ".build/",
        "Pods/",
        "Carthage/"
      ]
    },
    {
      "id": "typescript",
      "source": "@groma/scanner-typescript@0.2.4",
      "include": [
        "**/*.ts",
        "**/*.tsx",
        "**/tsconfig*.json",
        "**/package.json",
        "**/*.html",
        "**/angular.json",
        "**/project.json",
        "**/nx.json"
      ],
      "exclude": [
        "*.test.ts",
        "*.test.tsx",
        "*.spec.ts",
        "*.spec.tsx",
        "/test/",
        "node_modules/",
        "dist/",
        "build/",
        "coverage/"
      ]
    }
  ],
  "workSources": [],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.e2e.ts",
    "**/*.browser.e2e.ts",
    "**/browser-test/**",
    "**/tests/**",
    "**/__tests__/**",
    "/tooling/**",
    "/nix/**",
    "/infra/**",
    "/vendor/**",
    "/apps/web/scripts/**",
    "/apps/marketing/scripts/**",
    "/apps/docs/scripts/**",
    "/packages/sdk/scripts/**",
    "/packages/sdk-docs/scripts/**",
    "/packages/code-mode-sdk/scripts/**",
    "/packages/collaboration/scripts/**",
    "/crates/**/scripts/**",
    "/crates/**/e2e/**",
    "/services/websocket-service/**",
    "/services/transcription/**",
    "/services/ai-editing-worker/scripts/**",
    "/services/convert_service/load-test/**",
    "/services/convert_service/helpers/**",
    "/crates/email_formatting/preview_digest.py",
    "/crates/invite_email/preview_invite.py",
    "/crates/universal_input/eval/**"
  ],
  "automaticUpdates": true
}
